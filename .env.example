ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_MODE=anthropic          # anthropic | mock

# --- Integrations (set MODE to switch from mock to real) ---
GITHUB_MODE=mock            # mock | rest
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

SLACK_MODE=mock             # mock | webhook | bot   (bot enables streaming updates)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=            # xoxb-... — required for `bot` mode (chat.update)
SLACK_CHANNEL=#incidents

METRICS_MODE=mock           # mock | datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=

# --- Runtime profile and storage ---
ENVIRONMENT=development    # development | production
RUNBOOKS_DIR=./runbooks
POSTMORTEM_DIR=./postmortems
DB_PATH=./incidents.db
# Production requires PostgreSQL and Redis; development leaves these empty.
DATABASE_URL=              # postgresql+psycopg://user:pass@host/database
REDIS_URL=                 # rediss://host:6379/0 in production
REDIS_NAMESPACE=incident-response
REDIS_REQUIRE_TLS=true
QUEUE_RETRY_BASE_SECONDS=1
QUEUE_RETRY_MAX_SECONDS=60
QUEUE_MAX_ATTEMPTS=5
QUEUE_LEASE_SECONDS=300

# --- Operator identity and authorization ---
AUTH_MODE=disabled         # disabled | oidc (production requires oidc)
SESSION_SECRET=            # at least 32 random characters in production
SESSION_SECONDS=28800
SESSION_HTTPS_ONLY=true
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_METADATA_URL=         # https://idp.example/.well-known/openid-configuration
OIDC_GROUPS_CLAIM=groups
OIDC_VIEWER_GROUPS=incident-viewers
OIDC_RESPONDER_GROUPS=incident-responders
OIDC_ADMIN_GROUPS=incident-admins
# JSON object mapping lowercase SHA-256 token digests to viewer/responder/admin.
OPERATOR_BEARER_TOKENS=

# --- Webhook auth ---
WEBHOOK_TOKEN=change-me
DATADOG_WEBHOOK_SECRET=
PAGERDUTY_WEBHOOK_SECRET=
GENERIC_WEBHOOK_SECRET=

# --- Ownership and ticketing ---
PAGERDUTY_MODE=mock        # mock | disabled | pagerduty
PAGERDUTY_API_TOKEN=
# JSON mapping internal service names to PagerDuty service IDs.
PAGERDUTY_SERVICE_IDS=

JIRA_MODE=mock             # mock | disabled | jira
JIRA_BASE_URL=             # https://company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Incident

LINEAR_MODE=mock           # mock | disabled | linear
LINEAR_API_TOKEN=
LINEAR_TEAM_ID=

OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_RETRY_MAX_SECONDS=60
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=60
OUTBOX_POLL_SECONDS=0.5

# --- Rate limiting ---
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Deduplication ---
DEDUP_BUCKET_MINUTES=15
DEDUP_TTL_SECONDS=3600

# --- Remediation executor ---
REMEDIATION_MODE=mock       # mock | shell   (shell only runs allow-listed commands)
REMEDIATION_ALLOWED_COMMANDS=feature-flag,kubectl,deploy
REMEDIATION_TIMEOUT_SECONDS=30

# --- Post-remediation verification ---
VERIFICATION_ENABLED=true
VERIFICATION_TOTAL_MINUTES=10
VERIFICATION_POLL_SECONDS=30

# --- Observability ---
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=incident-response
# If set, spans are exported via OTLP HTTP to this endpoint (requires opentelemetry-*)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
